# Copy to backend/.env for local development. backend/.env is git-ignored: never commit it.
# Settings are read from BTW_* variables (see app/core/config.py).

# Address used in invitation links.
BTW_PUBLIC_URL=http://localhost:5173

# Brevo (free plan: 300 emails/day). In Brevo: Settings > SMTP & API > SMTP.
BTW_SMTP_HOST=smtp-relay.brevo.com
BTW_SMTP_PORT=587
BTW_SMTP_STARTTLS=true
# "Login" shown on that page (looks like 1a2b3c001@smtp-brevo.com).
BTW_SMTP_USERNAME=
# An SMTP key generated on that page (not your Brevo account password).
BTW_SMTP_PASSWORD=
# A sender verified in Brevo (Senders, Domains & Dedicated IPs > Senders).
BTW_SMTP_FROM=Behind the Wall <you@example.com>
